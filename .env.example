# ============================================================================
# VIOSINT - Visual Intelligence OSINT Platform
# Environment Configuration
# ============================================================================
# Copy this file to .env and update values for your environment
# ============================================================================

# --- App Settings ---
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key-in-production
APP_NAME=VIOSINT
APP_VERSION=0.1.0

# --- Demo Mode ---
# Set to true to auto-seed the database with realistic demo data on startup.
# The seed runs once (skips if data already exists).
DEMO_MODE=false

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=viosint
POSTGRES_USER=viosint
POSTGRES_PASSWORD=viosint_dev_password

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=viosint_dev_password

# --- CV Pipeline ---
CV_PIPELINE_URL=http://localhost:8001
YOLO_MODEL=yolov8n.pt
DETECTION_CONFIDENCE=0.5
DETECTION_DEVICE=cpu
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=openai
EMBEDDING_DEVICE=cpu
PROCESSING_FPS=10
MAX_CONCURRENT_STREAMS=4

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_CV_PIPELINE_URL=http://localhost:8001

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:80"]
